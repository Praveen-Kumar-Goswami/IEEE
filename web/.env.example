# Lambda API (backend/). Requests from the browser go through /api/backend, so the
# function URL's CORS settings do not apply to the web app.
NEXT_PUBLIC_API_BASE_URL=https://hs2vdl7ablstozg4sg5s4o3uiu0dnvqj.lambda-url.us-east-1.on.aws

# Supabase project the Lambda API is configured against. Leave empty to run on demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Force demo data even when Supabase is configured.
NEXT_PUBLIC_DEMO_MODE=false
